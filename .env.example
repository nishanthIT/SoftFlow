# Copy to .env and replace every CHANGE_ME before starting.
# Local npm start builds production assets; the LAN workspace has no login.
APP_ENV=production
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/sentinel
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=sentinel-storage
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
STORAGE_BUCKET=sentinel
STORAGE_BACKEND=minio
VIRUSTOTAL_API_KEY=
HYBRID_ANALYSIS_API_KEY=
EXTERNAL_UPLOADS_ENABLED=false
MAX_UPLOAD_MB=2048
# Chunk uploads use bounded memory; scratch must be a disk-backed writable path.
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_MAX_PENDING=8
STORAGE_RESERVE_BYTES=1073741824
# WORKER_TEMP_PATH=/absolute/path/to/writable/scratch
PROVIDER_TIMEOUT=900
# Public advisory services; keys are optional and never sent to the browser.
NVD_API_KEY=
GITHUB_ADVISORIES_TOKEN=
INTELLIGENCE_TIMEOUT=180
INTELLIGENCE_CACHE_HOURS=24
HYBRID_ENVIRONMENT_ID=160
CUCKOO_API_URL=
CUCKOO_API_TOKEN=
SANDBOX_KIND=cape
SANDBOX_ENABLED=false
SANDBOX_ISOLATION_CONFIRMED=false
# Cuckoo 3 local manager (separate interpreter; paths relative to this repository)
CUCKOO_AUTO_START=false
CUCKOO_REQUIRED=true
CUCKOO_WINDOWS_LICENSE_ACCEPTED=false
CUCKOO_PYTHON=python3.10
CUCKOO_BOOTSTRAP_PYTHON=true
CUCKOO_VENV=.local/cuckoo-venv
CUCKOO_CWD=.local/cuckoo
CUCKOO_SOURCE=.local/cuckoo3-src
CUCKOO_STARTUP_TIMEOUT=60
CUCKOO_INTERFACE=
CUCKOO_RESULTSERVER_IP=
SANDBOX_PLATFORM=windows
SANDBOX_OS_VERSION=10
SANDBOX_ANALYSIS_TIMEOUT=120
SANDBOX_NETWORK_POLICY=unknown
SANDBOX_ARTIFACT_MAX_BYTES=1073741824
PROVIDER_POLL_INTERVAL=15
REQUEST_TIMEOUT=30
# Optional local service ports; configure_local.py uses these consistently.
API_PORT=8100
FRONTEND_PORT=3100
LOCAL_POSTGRES_PORT=55432
LOCAL_REDIS_PORT=56379
# Grace period per shutdown phase; dependencies stay up if a worker cannot drain.
LOCAL_SHUTDOWN_TIMEOUT=120
YARA_PATH=/yara/rules
AI_SIGNATURES_PATH=/ai-signatures/providers.json
MOCK_ANALYSIS=false

# One HTTP LAN-facing port; API/database/queue remain local.
FRONTEND_HOST=0.0.0.0
# Approval policy is captured with each new analysis; empty results never qualify.
APPROVAL_MAX_SCORE=0
APPROVAL_REJECT_SCORE=60
APPROVAL_REQUIRE_REPUTATION=true
APPROVAL_MIN_REPUTATION_ENGINES=20
